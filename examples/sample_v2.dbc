BA_ "GenMsgCycleTime" BO_ 768 100;
BA_ "GenMsgCycleTime" BO_ 1280 20;

VAL_ 256 VCU_GearPos 0 "P" 1 "R" 2 "N" 3 "D" ;
VAL_ 256 VCU_BrakePedalSts 0 "Released" 1 "Pressed" 2 "Error" 3 "Invalid" ;
VAL_ 256 VCU_ReadyStatus 0 "NotReady" 1 "Ready" 2 "Fault" 3 "Invalid" ;
VAL_ 256 VCU_DrivingMode 0 "Normal" 1 "Sport" 2 "Eco" 3 "Snow" 4 "Custom" 5 "Auto" ;
VAL_ 512 MCU_SysStatus 0 "Init" 1 "Ready" 2 "Running" 3 "Fault" 4 "Shutdown" ;
VAL_ 1280 ADAS_LongCtrlReq 0 "Inactive" 1 "Active" 2 "Override" 3 "Fault" ;
VAL_ 1280 ADAS_LatCtrlReq 0 "Inactive" 1 "Active" 2 "Override" 3 "Fault" ;
VAL_ 1280 ADAS_SystemStatus 0 "Off" 1 "Standby" 2 "Active" 3 "Override" 4 "Fault" ;


