 SG_ VCU_DrivingMode : 28|3@1+ (1,0) [0|7] "" MCU,GW
 SG_ VCU_SteerAngle : 32|16@1- (0.1,-3276.8) [-3276.8|3276.7] "deg" ADAS,GW

BO_ 512 MCU_TorqueInfo : 8 MCU
