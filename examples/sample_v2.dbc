CM_ BU_ VCU "整车控制器";
CM_ BU_ MCU "电机控制器";
CM_ BU_ BMS "电池管理系统";
CM_ BU_ GW "网关";
CM_ BU_ ADAS "高级驾驶辅助系统";

CM_ BO_ 256 "VCU整车状态报文，周期10ms";
CM_ BO_ 512 "MCU电机扭矩信息报文，周期10ms";
CM_ BO_ 768 "BMS电池信息报文，周期100ms";
CM_ BO_ 1280 "ADAS控制指令报文，周期20ms";

CM_ SG_ 256 VCU_GearPos "档位：0=P, 1=R, 2=N, 3=D";
CM_ SG_ 256 VCU_VehicleSpeed "车速，精度0.05km/h（精度提升）";
CM_ SG_ 256 VCU_ReadyStatus "整车Ready状态：0=未就绪, 1=就绪, 2=故障";
CM_ SG_ 256 VCU_SteerAngle "方向盘转角，新增信号";
CM_ SG_ 512 MCU_ActualTorque "电机实际扭矩";
CM_ SG_ 512 MCU_FaultCode "故障码，位长度从8扩展到12";
CM_ SG_ 768 BMS_SOC "电池荷电状态";

BA_DEF_ BO_ "GenMsgCycleTime" INT 0 10000;
BA_DEF_ BO_ "GenMsgSendType" ENUM "Cyclic","Event","NoMsgSendType";
BA_DEF_ SG_ "SystemSignalLongSymbol" STRING;
BA_DEF_ SG_ "GenSigSendType" ENUM "Cyclic","Event","NoSigSendType";

BA_DEF_DEF_ "GenMsgCycleTime" 0;
BA_DEF_DEF_ "GenMsgSendType" "Cyclic";
